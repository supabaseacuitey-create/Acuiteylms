# Acuitey LMS — STAGING environment EXAMPLE for Coolify/manual use.
# Copy NOTHING from docker/local/.env here. This file contains PLACEHOLDERS
# ONLY. Real values live ONLY in Coolify environment settings (or a
# git-ignored local file that is never committed) — never in git, logs, or
# build arguments. Staging validation commands use ONLY this example file.
# NEVER run staging commands with `--env-file docker/local/.env`.

# --- PostgreSQL (staging) ---
POSTGRES_DB=moodle
POSTGRES_USER=moodle
POSTGRES_PASSWORD=CHANGEME-staging-db-password

# --- Moodle database settings (must match PostgreSQL above) ---
MOODLE_DB_HOST=db
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=CHANGEME-staging-db-password
MOODLE_DB_PREFIX=mdl_

# --- Moodle site (staging) ---
# Staging hostname is NOT yet approved. Never use the production portal
# hostname here. Use https: only (matches $CFG->sslproxy in the image).
STAGING_WWWROOT=https://STAGING-HOST-PLACEHOLDER
