# Acuitey LMS — local Docker environment EXAMPLE.
# Copy to `.env` (same folder) and fill in LOCAL-ONLY values.
# This file contains PLACEHOLDERS ONLY. Never put real secrets here.
# The real `.env` is git-ignored and must never be committed.

# --- PostgreSQL (local dev only) ---
POSTGRES_DB=moodle
POSTGRES_USER=moodle
POSTGRES_PASSWORD=CHANGEME-local-dev-only

# --- Moodle database settings (must match PostgreSQL above for local dev) ---
MOODLE_DB_HOST=db
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=CHANGEME-local-dev-only
MOODLE_DB_PREFIX=mdl_

# --- Moodle site ---
MOODLE_WWWROOT=http://localhost:8080

# --- Localhost web binding ---
APP_PORT=8080
