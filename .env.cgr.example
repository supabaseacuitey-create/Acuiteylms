# Code-Graph-RAG Configuration
# Copy this file to .env or set environment variables accordingly.

# Project Target
TARGET_REPO_PATH=C:\Users\Atul\Desktop\moodle

# Memgraph Database Configuration
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687

# Model Provider Options (Uncomment one option below)

# --- Option 1: Google Gemini (Recommended for Antigravity) ---
# CYPHER_PROVIDER=google
# CYPHER_MODEL=gemini-2.5-flash
# CYPHER_API_KEY=your-gemini-api-key
# ORCHESTRATOR_PROVIDER=google
# ORCHESTRATOR_MODEL=gemini-2.5-pro
# ORCHESTRATOR_API_KEY=your-gemini-api-key

# --- Option 2: OpenAI ---
# CYPHER_PROVIDER=openai
# CYPHER_MODEL=gpt-4o-mini
# CYPHER_API_KEY=your-openai-api-key
# ORCHESTRATOR_PROVIDER=openai
# ORCHESTRATOR_MODEL=gpt-4o
# ORCHESTRATOR_API_KEY=your-openai-api-key

# --- Option 3: Local Ollama ---
# CYPHER_PROVIDER=ollama
# CYPHER_MODEL=qwen2.5-coder
# CYPHER_ENDPOINT=http://localhost:11434/v1
